{
  "name": "ocvm-mcp-adapter",
  "version": "0.1.20",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "node --test dist/*.test.js",
    "pretest:integration": "npm run build",
    "test:integration": "node tests/opencode-integration.mjs",
    "test:taskboard": "npm run build && node tests/taskboard-integration.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "@opencode-ai/sdk": "1.18.21",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "typescript": "5.8.3"
  }
}
