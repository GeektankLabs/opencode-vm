+test("QC4: stale response after a receipt change is ignored (no misattribution)", async () => {
+  const { project, cleanup } = await setup();
+  try {
+    const state = baseState();
+    const { gateway, board } = fakes(state);
+    const origStatus = gateway.getSessionStatus.bind(gateway);
+    gateway.getSessionStatus = async (sessionId: string, messageId?: string) => {
+      if (sessionId === "ses_worker") await new Promise((resolve) => setTimeout(resolve, 120));
+      return origStatus(sessionId, messageId);
+    };
+    const engine = new MonitorEngine({ project, gateway, board, readPolicy: async () => policyConfigured, now: () => 200_000, engineGeneration: "gen-qc4" });
+    await withRegistry(project, (registry) => {
+      const monitor = defaultMonitorRecord("M", TASK, { interval_seconds: 60 }, 100_000);
+      monitor.scheduler.next_run_at = 0;
+      registry.monitors.push(monitor);
+      return registry;
+    });
+    const monitorId = (await readRegistrySnapshot(project)).registry.monitors[0]!.id;
+    const reserved = await reserveWorker(project, monitorId, { runtime_session_id: "ses_worker" }, { now: 100_400 });
+    await confirmWorkerCreation(project, monitorId, reserved.worker_key, { runtime_session_id: "ses_worker", creation_receipt: "msg_create" }, { now: 100_500 });
+    await rebindWorker(project, monitorId, reserved.worker_key, { runtime_session_id: "ses_worker", dispatch_receipt: "msg_old" }, { now: 100_600 });
+    await withRegistry(project, (registry) => {
+      registry.monitors[0]!.run = { active: true, started_at: new Date(200_000).toISOString(), action: null, owner_pid: process.pid, owner_generation: "gen-qc4" };
+      return registry;
+    });
+    const observing = engine.observe();
+    await new Promise((resolve) => setTimeout(resolve, 30));
+    await rebindWorker(project, monitorId, reserved.worker_key, { runtime_session_id: "ses_worker", dispatch_receipt: "msg_new" }, { now: 100_700 });
+    await observing;
+    const record = (await readRegistrySnapshot(project)).registry.monitors[0]!;
+    assert.equal(record.history.find((h) => h.type === "observer-probe" && JSON.stringify(h.detail ?? {}).includes("msg_old")), undefined, "no probe decision attributed to the stale receipt");
+  } finally {
+    await cleanup();
+  }
+});
