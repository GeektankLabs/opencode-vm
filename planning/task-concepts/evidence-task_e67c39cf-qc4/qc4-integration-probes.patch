+// QC4-INTEGRATION (independent integration review, Main c426e28): counter-probes.
+test("QC4: Z1 — during a genuinely hung investigation await the observer probes, persists evidence, releases nothing, no double dispatch", async () => {
+  const { project, cleanup } = await setup();
+  try {
+    const state = baseState();
+    const { gateway, board } = fakes(state);
+    let release: () => void = () => undefined;
+    const gate = new Promise<void>((resolve) => { release = resolve; });
+    gateway.getSessionProgress = async () => { await gate; return progressResult("ses_worker", 99); };
+    const engineFactory = (now: number) =>
+      new MonitorEngine({ project, gateway, board, readPolicy: async () => policyConfigured, now: () => now, engineGeneration: "gen-qc4" });
+    await withRegistry(project, (registry) => {
+      const monitor = defaultMonitorRecord("M", TASK, { interval_seconds: 60 }, 100_000);
+      monitor.scheduler.next_run_at = 0;
+      monitor.state.last_seen_digest = "different";
+      registry.monitors.push(monitor);
+      return registry;
+    });
+    await engineFactory(100_000).tick();
+    const monitorId = (await readRegistrySnapshot(project)).registry.monitors[0]!.id;
+    const reserved = await reserveWorker(project, monitorId, { runtime_session_id: "ses_worker" }, { now: 100_400 });
+    await confirmWorkerCreation(project, monitorId, reserved.worker_key, { runtime_session_id: "ses_worker", creation_receipt: "msg_create" }, { now: 100_500 });
+    await rebindWorker(project, monitorId, reserved.worker_key, { runtime_session_id: "ses_worker", dispatch_receipt: "msg_dispatch" }, { now: 100_600 });
+    await seedDueWorker(project, reserved.worker_key, 150_000);
+
+    const engine2 = engineFactory(200_000);
+    const blockedTick = engine2.tick();
+    await new Promise((resolve) => setTimeout(resolve, 60));
+    let record = (await readRegistrySnapshot(project)).registry.monitors[0]!;
+    assert.equal(record.run.active, true, "wake claim held");
+    const walBefore = record.dispatch_wal ? { id: record.dispatch_wal.action_id, msg: record.dispatch_wal.message_id } : null;
+
+    const sendsBefore = state.sends.length;
+    const statusBefore = state.statusCalls.filter((c) => c.session_id === "ses_worker").length;
+    await engine2.observe();
+    const workerStatusAfter = state.statusCalls.filter((c) => c.session_id === "ses_worker").length;
+    assert.ok(workerStatusAfter > statusBefore, "observer performed a REAL status probe during the blocked wake");
+    record = (await readRegistrySnapshot(project)).registry.monitors[0]!;
+    assert.ok(record.history.some((h) => h.type === "observer-probe"), "observer-probe decision persisted during blockage");
+    assert.equal(record.run.active, true, "observer still never releases the claim");
+    assert.equal(record.investigation!.episode, null, "no episode from the probe lane");
+    assert.equal(state.sends.length, sendsBefore, "observer sent nothing");
+    assert.equal(await engine2.tick(), "skipped", "next tick still blocked by waking");
+
+    release();
+    assert.equal(await blockedTick, "investigated");
+    record = (await readRegistrySnapshot(project)).registry.monitors[0]!;
+    const walAfter = record.dispatch_wal ? { id: record.dispatch_wal.action_id, msg: record.dispatch_wal.message_id } : null;
+    assert.deepEqual(walAfter, walBefore, "no duplicate dispatch");
+    assert.equal(state.sends.length, sendsBefore, "still zero sends from observer/investigation");
+  } finally {
+    await cleanup();
+  }
+});
