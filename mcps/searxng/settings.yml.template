use_default_settings: true

general:
  instance_name: "opencode-vm SearXNG"
  donation_url: false
  contact_url: false
  enable_metrics: false

server:
  bind_address: "0.0.0.0"
  port: 8080
  base_url: "http://127.0.0.1:8888/"
  secret_key: "__SECRET_KEY__"
  # Private localhost-only MCP backend — rate-limiting and bot-detection are
  # not needed (and the limiter would block direct curl/MCP calls that lack
  # X-Forwarded-For headers with HTTP 429).
  limiter: false
  public_instance: false
  image_proxy: false
  http_protocol_version: "1.1"
  method: "GET"
  default_http_headers:
    X-Content-Type-Options: nosniff
    X-Download-Options: noopen
    X-Robots-Tag: noindex, nofollow
    Referrer-Policy: no-referrer

ui:
  static_use_hash: true
  default_locale: "en"
  query_in_title: false
  infinite_scroll: false
  center_alignment: false
  default_theme: "simple"
  theme_args:
    simple_style: "auto"
  search_on_category_select: true
  hotkeys: "default"

search:
  safe_search: 0
  autocomplete: ""
  default_lang: "all"
  ban_time_on_fail: 5
  max_ban_time_on_fail: 120
  formats:
    - html
    - json

valkey:
  url: valkey://valkey:6379/0

outgoing:
  request_timeout: 6.0
  max_request_timeout: 10.0
  pool_connections: 100
  pool_maxsize: 20
  enable_http2: true
