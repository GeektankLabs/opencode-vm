{
  "$schema_version": "1",
  "mcps": {
    "playwright": {
      "description": "Headless browser automation (Chromium pre-installed in base VM)",
      "default_active": true,
      "install": {
        "type": "bundled",
        "notes": "Installed globally in the base VM via npm i -g @playwright/mcp; Chromium pre-downloaded."
      },
      "credential_schema": [],
      "mcp_config": {
        "type": "local",
        "command": ["playwright-mcp", "--headless", "--browser", "chromium"]
      },
      "agents_md_snippet": {
        "source": "file",
        "path": "mcps/playwright/AGENTS-snippet.md"
      }
    },
    "repomapper": {
      "description": "PageRank-ranked structural maps of the current codebase",
      "default_active": false,
      "install": {
        "type": "bundled",
        "notes": "Installed in the base VM at ~/.local/share/repomapper/."
      },
      "credential_schema": [],
      "mcp_config": {
        "type": "local",
        "command": ["python3", "{VM_HOME}/.local/share/repomapper/repomap_server.py"]
      },
      "agents_md_snippet": {
        "source": "file",
        "path": "mcps/repomapper/AGENTS-snippet.md"
      }
    },
    "graphify": {
      "description": "Code knowledge-graph (tree-sitter AST) — cross-file relationships, communities, god-nodes",
      "default_active": false,
      "install": {
        "type": "bundled",
        "notes": "graphifyy installed via pipx in base VM; CLI at ~/.local/bin/graphify; MCP server invoked through /usr/local/bin/graphify-serve-wrapper.sh."
      },
      "credential_schema": [],
      "mcp_config": {
        "type": "local",
        "command": ["/usr/local/bin/graphify-serve-wrapper.sh", "{GRAPH_PATH}"]
      },
      "agents_md_snippet": {
        "source": "file",
        "path": "mcps/graphify/AGENTS-snippet.md",
        "path_mcrepo": "mcps/graphify/AGENTS-snippet.mcrepo.md"
      }
    },
    "searxng": {
      "description": "Account-free metasearch (SearXNG container in base VM; aggregates Google/Bing/DuckDuckGo/Brave/Wikipedia, privacy-preserving)",
      "default_active": true,
      "install": {
        "type": "bundled",
        "notes": "MCP wrapper (mcp-searxng@1.0.3) installed via npm i -g in base VM; SearXNG container runs persistently in oc-base via ocvm-searxng.service."
      },
      "credential_schema": [],
      "mcp_config": {
        "type": "local",
        "command": ["npx", "-y", "mcp-searxng"],
        "environment": {
          "SEARXNG_URL": "http://127.0.0.1:8888"
        }
      },
      "agents_md_snippet": {
        "source": "file",
        "path": "mcps/searxng/AGENTS-snippet.md"
      }
    },
    "proxmox": {
      "description": "Proxmox VE cluster operations via ProxmoxMCP server",
      "default_active": false,
      "install": {
        "type": "git",
        "repo": "https://github.com/canvrno/ProxmoxMCP.git",
        "ref": "main",
        "notes": "Cloned host-side on enable; Python venv installed in base VM on first session."
      },
      "credential_schema": [
        { "field": "PROXMOX_HOST",        "prompt": "Proxmox host (e.g. pve.example.com)", "secret": false, "required": true },
        { "field": "PROXMOX_PORT",        "prompt": "API port",                             "secret": false, "required": false, "default": "8006" },
        { "field": "PROXMOX_USER",        "prompt": "Token user (e.g. root@pam)",           "secret": false, "required": true },
        { "field": "PROXMOX_TOKEN_NAME",  "prompt": "Token name",                           "secret": false, "required": true },
        { "field": "PROXMOX_TOKEN_VALUE", "prompt": "Token value",                          "secret": true,  "required": true },
        { "field": "PROXMOX_VERIFY_SSL",  "prompt": "Verify SSL (0/1)",                     "secret": false, "required": false, "default": "0" }
      ],
      "skill_doc": "skills/proxmox",
      "mcp_config": {
        "type": "local",
        "command": ["{VM_HOME}/.local/share/proxmox-mcp-venv/bin/python", "-m", "proxmox_mcp.server"],
        "environment_from_credentials": true
      }
    }
  }
}
